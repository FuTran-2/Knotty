# Cognito Configuration
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_yourPoolId
VITE_COGNITO_USER_POOL_CLIENT_ID=yourClientId
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com

# Redirect URIs (optional, defaults to localhost:5173 or your production domain)
# VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/
# VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/

# Photo Upload Configuration
# Option 1: Direct S3 Upload (requires AWS keys in .env.local)
# VITE_AWS_REGION=us-east-1
# VITE_AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# VITE_AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_S3_BUCKET=knotty-photos

# Option 2: Serverless Backend (scaffold only; frontend does not use this yet)
# VITE_UPLOAD_URL_ENDPOINT=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/upload-url

# If no options are configured, the app falls back to local base64 resizing.
